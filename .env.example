# -----------------------------------------------------------------------------
# Copy to .env and fill in. .env is git-ignored: never commit real secrets.
# -----------------------------------------------------------------------------

## FXServer artifact pin (folder name from
## https://runtime.fivem.net/artifacts/fivem/build_proot_linux/master/)
ARTIFACT_BUILD=
## Optional but recommended: sha256 of that build's fx.tar.xz
ARTIFACT_SHA256=

## Image names (override to use images pushed to GHCR)
FXSERVER_IMAGE=fivem-server-ops/fxserver:local
EXPORTER_IMAGE=fivem-server-ops/exporter:local
BACKUP_IMAGE=fivem-server-ops/backup:local

## Cfx.re license key (https://portal.cfx.re). Placeholder only.
FIVEM_LICENSE_KEY=cfxk_changeme_changeme

## Server identity
FIVEM_HOSTNAME=My FiveM Server
FIVEM_PROJECT_NAME=fivem-server-ops
FIVEM_PROJECT_DESC=Containerized FXServer with backups and monitoring
FIVEM_TAGS=roleplay,english
FIVEM_LOCALE=en-US
FIVEM_MAX_CLIENTS=48
FIVEM_GAME_BUILD=3095
STEAM_WEBAPIKEY=

## Ports
FIVEM_PORT=30120
## txAdmin: set TXADMIN_ENABLED=true to let txAdmin manage the server.
## The panel is bound to localhost by default: reach it through an SSH tunnel
## (ssh -L 40120:127.0.0.1:40120 user@vps). See README "txAdmin access".
TXADMIN_ENABLED=false
TXADMIN_PORT=40120
TXADMIN_BIND=127.0.0.1

## MariaDB
MARIADB_ROOT_PASSWORD=change-me-root
MARIADB_DATABASE=fivem
MARIADB_USER=fivem
MARIADB_PASSWORD=change-me-fivem

## Backups
## Cron expression (container TZ) and local retention
BACKUP_SCHEDULE=0 */6 * * *
BACKUP_KEEP_LOCAL=8
BACKUP_KEEP_REMOTE_DAYS=30
## rclone remote "name:bucket/path". Leave empty to keep backups local only.
BACKUP_REMOTE=s3backup:my-fivem-backups/prod
## Optional dead man's switch pinged after each run (e.g. a healthchecks.io check URL)
BACKUP_PING_URL=
## rclone remote configured through environment variables (no rclone.conf needed)
RCLONE_CONFIG_S3BACKUP_TYPE=s3
RCLONE_CONFIG_S3BACKUP_PROVIDER=Other
RCLONE_CONFIG_S3BACKUP_ENDPOINT=https://s3.example.com
RCLONE_CONFIG_S3BACKUP_REGION=auto
RCLONE_CONFIG_S3BACKUP_ACCESS_KEY_ID=
RCLONE_CONFIG_S3BACKUP_SECRET_ACCESS_KEY=

## Monitoring
GRAFANA_ADMIN_PASSWORD=change-me-grafana
TZ=Europe/Paris
